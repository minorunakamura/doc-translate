{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": { "typeAware": true },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": { "no-console": "warn", "no-debugger": "error" },
  "ignorePatterns": ["node_modules/**", "dist/**", "package-lock.json"]
}
