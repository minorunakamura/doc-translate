{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": { "typeAware": true },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": { "no-console": "warn", "no-debugger": "error" },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "pnpm-lock.yaml",
    "package-lock.json"
  ]
}
